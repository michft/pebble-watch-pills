{
  "name": "number-watch",
  "author": "mt",
  "version": "0.2.5",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pebble build --watch",
    "build": "pebble build",
    "release:check": "node scripts/release-metadata.js",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.ts tests/*.test.js"
  },
  "pebble": {
    "displayName": "Number Watch",
    "uuid": "0b31b7f2-71e8-4610-830d-f7eaebef5494",
    "projectType": "native",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery"
    ],
    "capabilities": [
      "configurable",
      "wakeup"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "TYPE",
      "PAYLOAD",
      "H_ALIGN",
      "V_ALIGN",
      "FONT_SIZE",
      "TEXT_COLOR",
      "BACKGROUND_COLOR",
      "USE_LOCAL_TIME",
      "UTC_OFFSET_MINUTES",
      "ALT_TEXT_COLOR",
      "ALT_BACKGROUND_COLOR",
      "ALT_TZ_LABEL",
      "ALT_UTC_OFFSET_MINUTES",
      "ALT_TRANSITION_AT",
      "ALT_TRANSITION_OFFSET_MINUTES",
      "SLOT_0_HOUR",
      "SLOT_0_MINUTE",
      "SLOT_0_ENABLED",
      "SLOT_1_HOUR",
      "SLOT_1_MINUTE",
      "SLOT_1_ENABLED",
      "SLOT_2_HOUR",
      "SLOT_2_MINUTE",
      "SLOT_2_ENABLED",
      "SLOT_3_HOUR",
      "SLOT_3_MINUTE",
      "SLOT_3_ENABLED"
    ],
    "resources": {
      "media": []
    }
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
